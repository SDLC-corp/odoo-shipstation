<odoo>
    <!-- Odoo 16 has no res.groups.privilege: the three roles live in their own application
         category (under Inventory) so they render as one Reader < Manager < Admin selection
         and never merge into the Inventory app's own selection. -->
    <record id="module_category_shipstation" model="ir.module.category">
        <field name="name">ShipStation</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="sequence">30</field>
    </record>
    <record id="group_shipstation_user_readonly" model="res.groups">
        <field name="name">ShipStation User (Read Only)</field>
        <field name="category_id" ref="module_category_shipstation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_shipstation_manager" model="res.groups">
        <field name="name">ShipStation Manager</field>
        <field name="category_id" ref="module_category_shipstation"/>
        <field name="implied_ids" eval="[(4, ref('group_shipstation_user_readonly'))]"/>
    </record>
    <record id="group_shipstation_admin" model="res.groups">
        <field name="name">ShipStation Admin</field>
        <field name="category_id" ref="module_category_shipstation"/>
        <field name="implied_ids" eval="[(4, ref('group_shipstation_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_shipstation_admin'))]"/>
    </record>
</odoo>
