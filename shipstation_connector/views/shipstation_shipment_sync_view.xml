<odoo>
    <record id="view_shipstation_shipment_sync_tree" model="ir.ui.view">
        <field name="name">shipstation.shipment.sync.tree</field>
        <field name="model">shipstation.shipment.sync</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_open_delivery_order" type="object" string="Open Delivery" class="btn-secondary"/>
                    <button name="action_open_tracking" type="object" string="Open Tracking" class="btn-secondary"/>
                    <button name="action_retry_delivery_link" type="object" string="Recheck Delivery Link" groups="shipstation_connector.group_shipstation_admin" class="btn-secondary"/>
                </header>
                <field name="shipstation_order_id"/>
                <field name="shipstation_order_number"/>
                <field name="ship_date"/>
                <field name="tracking_number"/>
                <field name="link_state"/>
                <field name="status"/>
                <field name="synced_on"/>
            </list>
        </field>
    </record>

    <record id="view_shipstation_shipment_sync_form" model="ir.ui.view">
        <field name="name">shipstation.shipment.sync.form</field>
        <field name="model">shipstation.shipment.sync</field>
        <field name="arch" type="xml">
            <form string="ShipStation Shipment">
                <header>
                    <button name="action_open_delivery_order" type="object" string="Open Delivery" class="btn-secondary"/>
                    <button name="action_open_tracking" type="object" string="Open Tracking" class="btn-secondary"/>
                    <button name="action_retry_delivery_link" type="object" string="Recheck Delivery Link" groups="shipstation_connector.group_shipstation_admin" class="btn-secondary"/>
                    <button name="action_acknowledge_void" type="object" string="Acknowledge Void" class="btn-primary"
                            groups="shipstation_connector.group_shipstation_admin,shipstation_connector.group_shipstation_manager" invisible="not voided or link_state != 'review'"
                            confirm="Confirm the voided label has been handled (replacement bought or not needed)?"/>
                </header>
                <sheet>
                    <group>
                        <field name="instance_id"/>
                        <field name="shipstation_shipment_id"/>
                        <field name="shipstation_order_id"/>
                        <field name="shipstation_order_number"/>
                        <field name="shipstation_store_id"/>
                        <field name="carrier_code"/>
                        <field name="service_code"/>
                        <field name="tracking_number"/>
                        <field name="tracking_url"/>
                        <field name="ship_date"/>
                        <field name="status"/>
                        <field name="voided" readonly="1"/>
                        <field name="void_date" readonly="1" invisible="not voided"/>
                        <field name="picking_id" readonly="1"/>
                        <field name="link_state" readonly="1"/>
                        <field name="link_message" readonly="1"/>
                        <field name="synced_on"/>
                    </group>
                    <group>
                        <field name="payload"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
